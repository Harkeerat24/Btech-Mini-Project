# ─────────────────────────────────────────────────────
# GraphRAG — .gitignore
# ─────────────────────────────────────────────────────

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/
venv/
env/

# Generated data artifacts (rebuilt from PDF — never commit)
data/

# User uploads (runtime only)
uploads/

# Secrets — never commit
.env

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# ─────────────────────────────────────────────────────
# GraphRAG System — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to git.
# ─────────────────────────────────────────────────────

# LLM settings (required)
LLM_MODEL=llama3.2
RETRIEVAL_TOP_K=5

# HuggingFace token (optional — removes rate limit warning)
# Get one free at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Neo4j Aura credentials (only needed for neo4j_export.py)
# Download from https://console.neo4j.io when creating your instance
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=your-instance-id

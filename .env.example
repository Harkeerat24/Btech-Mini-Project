# GraphMind environment configuration
# Copy this file to .env and fill in values for your selected provider.

# Selected Provider Matrix: 'ollama' | 'openai' | 'gemini'
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Provider credentials (provide values based on your LLM_PROVIDER choice)
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# Retrieval controls
TOP_K_VECTOR=5
TOP_K_KEYWORD=5
MAX_HOPS=2
MAX_CONTEXT_CHUNKS=8

# Hybrid score weights
SCORE_WEIGHT_VECTOR=0.50
SCORE_WEIGHT_KEYWORD=0.25
SCORE_WEIGHT_GRAPH=0.25

# HuggingFace token (optional)
HF_TOKEN=hf_your_token_here

# Neo4j export configuration (optional)
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j
